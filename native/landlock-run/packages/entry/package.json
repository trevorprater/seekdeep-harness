{
  "name": "@seekdeep-ai/node-addon-landlock-run",
  "version": "0.1.1",
  "type": "module",
  "description": "Rust Landlock self-restrict-then-exec launcher and compiled Node entry API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seekdeep-harness/seekdeep-harness.git",
    "directory": "native/landlock-run/packages/entry"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "lib/",
    "!lib/*.tsbuildinfo"
  ],
  "scripts": {
    "build:js": "cargo run --locked --quiet --manifest-path ../../../../Cargo.toml --package seekdeep-landlock-tools --bin landlock-build-entry",
    "prepack": "cargo run --locked --quiet --manifest-path ../../../../Cargo.toml --package seekdeep-landlock-tools --bin landlock-verify-entry-lib -- --rust-wasm"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@seekdeep-ai/node-addon-landlock-run-linux-arm64": "workspace:*",
    "@seekdeep-ai/node-addon-landlock-run-linux-x64": "workspace:*"
  }
}
