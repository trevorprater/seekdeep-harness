{
  "name": "@seekdeep-ai/seekdeep-root",
  "version": "0.1.0-rc.5",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "native/landlock-run",
    "native/landlock-run/packages/*",
    "apps/*",
    "website"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:web",
    "build:lib": "npm run build:lib:host && npm run build:lib:client",
    "build:lib:host": "tsc -b tsconfig.host.json && tsdown --env.SEEKDEEP_BUILD_FACE host",
    "build:lib:client": "cargo xtask build-client",
    "build:web": "pnpm --filter @seekdeep-ai/seekdeep-web-frontend run build",
    "clean": "cargo run --quiet -p seekdeep-repository-tools --bin clean --",
    "change-scope": "cargo run --quiet --package seekdeep-change-scope --",
    "typecheck": "npm run build:lib:host && npm run typecheck:contracts-ready",
    "typecheck:contracts-ready": "tsc -b tsconfig.client.json",
    "lint": "npm run build:lib:host && npm run lint:contracts-ready",
    "lint:contracts-ready": "cargo run --quiet --package seekdeep-repository-tools --bin run-oxlint -- .",
    "lint:fix": "npm run build:lib:host && npm run lint:fix:contracts-ready",
    "lint:fix:contracts-ready": "cargo run --quiet --package seekdeep-repository-tools --bin run-oxlint -- --config .oxlintrc.staged.json packages/typert/generator/tests/fixtures/type-model --fix && cargo run --quiet --package seekdeep-repository-tools --bin run-oxlint -- . --fix",
    "duplication": "jscpd --config .jscpd.json packages scripts",
    "test": "vitest run",
    "test:coverage": "cargo run --quiet -p seekdeep-repository-tools --bin run-coverage --",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:issue-management": "cargo test -p seekdeep-issue-policy",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:snapshot:record": "SEEKDEEP_SNAPSHOT=record vitest run --config vitest.snapshot.config.ts --update",
    "test:snapshot:refresh": "SEEKDEEP_SNAPSHOT=refresh vitest run --config vitest.snapshot.config.ts",
    "migrate:packed-session-fixtures": "cargo xtask session-fixture-layout --rewrite",
    "test:web": "npm run build && npm run test:web:built",
    "test:web:refresh": "npm run build && SEEKDEEP_SNAPSHOT=refresh vitest run --config vitest.web.config.ts",
    "test:web:built": "vitest run --config vitest.web.config.ts",
    "test:web:perf": "npm run build && npm run test:web:perf:built",
    "test:web:perf:built": "SEEKDEEP_SNAPSHOT=replay vitest run --config vitest.web.perf.config.ts",
    "test:web:stress": "npm run build && vitest run --config vitest.web-stress.config.ts",
    "test:gui": "vitest run packages/client packages/host",
    "check:all": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- check-all",
    "check:ci": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-primary",
    "check:ci:linux-primary": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-linux-primary",
    "check:ci:static": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-static",
    "check:ci:lint:contracts-ready": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-lint-contracts-ready",
    "check:ci:coverage": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-coverage",
    "check:ci:snapshot": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-snapshot",
    "check:ci:artifacts": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-artifacts",
    "check:ci:consumers": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-consumers",
    "check:windows-wine": "bash scripts/wine-windows-gates.sh",
    "check:ci:windows-blocking": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-windows-blocking",
    "check:ci:windows-complete": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-windows-complete",
    "check:ci:windows-observational": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- ci-windows-observational",
    "check:node-compat": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- node-compat",
    "knip": "knip --treat-config-hints-as-errors",
    "publint": "cargo run --quiet --package seekdeep-repository-tools --bin publint-all",
    "doc-typecheck": "cargo run --quiet -p seekdeep-repository-tools --bin doc-typecheck --",
    "doc-typecheck:contracts-ready": "cargo run --quiet -p seekdeep-repository-tools --bin doc-typecheck -- --use-build-output",
    "verify-md-wrap": "cargo run --quiet --package seekdeep-repository-tools --bin verify-md-wrap",
    "verify-md-links": "cargo run --quiet --package seekdeep-repository-tools --bin verify-md-links",
    "verify-doc-site-fragments": "cargo run --quiet --package seekdeep-repository-tools --bin verify-doc-site-fragments",
    "verify-public-repository-links": "cargo run --quiet --package seekdeep-repository-tools --bin verify-public-repository-links",
    "verify-doc-refs": "cargo run --quiet --package seekdeep-repository-tools --bin verify-doc-refs",
    "verify-package-paths": "cargo run --quiet --package seekdeep-repository-tools --bin verify-package-paths",
    "verify-seekdeep-package-licenses": "cargo run --quiet --package seekdeep-repository-tools --bin verify-seekdeep-package-licenses",
    "verify-config-source-ownership": "cargo run --quiet --package seekdeep-repository-tools --bin verify-config-source-ownership",
    "verify-package-invariants": "cargo run --quiet --package seekdeep-repository-tools --bin verify-package-invariants",
    "verify-built-package-invariants": "cargo run --quiet --package seekdeep-repository-tools --bin verify-built-package-invariants",
    "verify-package-readme-model-experience": "cargo run --quiet -p seekdeep-repository-tools --bin verify-package-readme-model-experience --",
    "verify-mermaid": "cargo run --quiet --package seekdeep-repository-tools --bin verify-mermaid",
    "verify-agent-note-classification": "cargo run --quiet --package seekdeep-repository-tools --bin verify-agent-note-classification",
    "verify-agent-note-format": "cargo run --quiet --package seekdeep-repository-tools --bin verify-agent-note-format",
    "verify-archived-agent-notes": "cargo run --quiet --package seekdeep-repository-tools --bin verify-archived-agent-notes --",
    "verify-type-equiv": "cargo run --quiet -p seekdeep-repository-tools --bin verify-type-equiv --",
    "verify-skill-invocation-metadata": "cargo run --quiet --package seekdeep-repository-tools --bin verify-skill-invocation-metadata",
    "verify-translation-prompt": "cargo run --quiet --package seekdeep-repository-tools --bin verify-translation-prompt --",
    "verify-translation-pairing": "cargo run --quiet --package seekdeep-repository-tools --bin verify-translation-pairing --",
    "resolve-translation-pairing-conflicts": "cargo run --quiet --package seekdeep-repository-tools --bin merge-translation-pairing -- --resolve",
    "install-lefthook": "cargo build --quiet --package seekdeep-repository-tools --bin merge-translation-pairing && cargo run --quiet --package seekdeep-repository-tools --bin install-lefthook",
    "gen-translation-brief": "cargo run --quiet --package seekdeep-repository-tools --bin gen-translation-brief --",
    "verify-doc-budgets": "cargo run --quiet --package seekdeep-repository-tools --bin verify-doc-budgets --",
    "docs:project": "cargo run --quiet --package seekdeep-repository-tools --bin project-doc-site --",
    "docs:prepare": "cargo run --quiet --package seekdeep-repository-tools --bin project-doc-site -- --prepare",
    "docs:runtime:check": "cargo test --package seekdeep-docs-site-runtime --test built_parity -- --ignored --nocapture",
    "docs:dev": "pnpm --filter @seekdeep-ai/website run dev",
    "docs:build": "pnpm --filter @seekdeep-ai/website run build && pnpm run verify-doc-site-fragments",
    "docs:build:mpa": "pnpm run docs:prepare && pnpm --filter @seekdeep-ai/website exec vitepress build . --mpa && pnpm run verify-doc-site-fragments",
    "docs:preview": "pnpm --filter @seekdeep-ai/website run preview",
    "docs:check": "cargo test --package seekdeep-repository-tools --test doc_site_projection_parity --test doc_site_configuration_parity --test doc_source_links --test doc_site_fragments_parity && pnpm run docs:build && pnpm run docs:runtime:check",
    "website:dev": "pnpm run docs:dev",
    "website:build": "pnpm run docs:build",
    "verify-package-readme-limitations": "cargo run --quiet --package seekdeep-repository-tools --bin verify-package-readme-limitations",
    "verify-node-next-types": "cargo run --quiet --package seekdeep-repository-tools --bin verify-node-next-types",
    "verify-runtime-closure": "cargo run --quiet --package seekdeep-repository-tools --bin verify-runtime-closure --",
    "verify-vendored-links": "cargo run --quiet --package seekdeep-repository-tools --bin verify-vendored-links",
    "verify-cordis-config": "cargo run --quiet --package seekdeep-repository-tools --bin verify-cordis-config",
    "rescope-vendor": "cargo run --quiet -p seekdeep-repository-tools --bin rescope-vendor --",
    "rescope-vendor:check": "cargo run --quiet -p seekdeep-repository-tools --bin rescope-vendor -- --check",
    "verify-client-domain-graph": "cargo run --quiet --package seekdeep-repository-tools --bin verify-client-domain-graph",
    "gen-cordis-catalog": "cargo xtask cordis-catalog",
    "verify-cordis-catalog": "cargo xtask cordis-catalog --check",
    "gen-cordis-api": "cargo xtask cordis-catalog",
    "verify-cordis-api": "cargo xtask cordis-catalog --check",
    "gen-client-catalog": "cargo xtask client-catalog",
    "gen-cordis-inspect-catalog": "cargo xtask cordis-inspect-catalog",
    "verify-client-catalog": "cargo xtask client-catalog --check",
    "verify-export-jsdoc": "cargo xtask docs",
    "gen-tool-catalog": "cargo xtask tool-catalog",
    "verify-tool-catalog": "cargo xtask tool-catalog --check",
    "gen-config-catalog": "cargo xtask config-catalog",
    "verify-config-catalog": "cargo xtask config-catalog --check",
    "gen-doc-graphs": "cargo xtask doc-graphs",
    "verify-doc-graphs": "cargo xtask doc-graphs --check",
    "gen-persistence-catalog": "cargo xtask persistence-catalog",
    "verify-persistence-catalog": "cargo xtask persistence-catalog --check",
    "gen-third-party-notices": "cargo run --quiet -p seekdeep-repository-tools --bin gen-third-party-notices --",
    "verify-third-party-notices": "cargo run --quiet -p seekdeep-repository-tools --bin gen-third-party-notices -- --check",
    "gen-module-graph": "cargo run --quiet --package seekdeep-repository-tools --bin gen-module-graph",
    "gen-scoped-events": "cargo run --quiet --package seekdeep-repository-tools --bin gen-scoped-events",
    "verify-scoped-events": "cargo run --quiet --package seekdeep-repository-tools --bin gen-scoped-events -- --check",
    "verify-module-graph": "cargo run --quiet --package seekdeep-repository-tools --bin gen-module-graph -- --check",
    "constraints": "cargo run --quiet --package seekdeep-repository-tools --bin check-workspace-constraints --",
    "doc-sync": "cargo run --quiet --package seekdeep-repository-tools --bin run-gates -- doc-sync",
    "hygiene": "pnpm run rescope-vendor:check && pnpm run knip && pnpm run publint && pnpm run constraints && pnpm run verify-seekdeep-package-licenses && pnpm run verify-package-invariants && pnpm run verify-built-package-invariants && pnpm run verify-cordis-config && pnpm run verify-node-next-types && pnpm run verify-runtime-closure && pnpm run verify-vendored-links",
    "publish:npm-baseline": "cargo run --quiet -p seekdeep-repository-tools --bin publish-npm-baseline --",
    "release:seekdeep": "cargo run --quiet --package seekdeep-repository-tools --bin release-bump -- --family seekdeep",
    "release:vendor": "cargo run --quiet --package seekdeep-repository-tools --bin release-bump -- --family vendor",
    "release:verify": "cargo run --quiet --package seekdeep-repository-tools --bin release-verify --",
    "release:pack": "cargo run --quiet --package seekdeep-repository-tools --bin release-pack --",
    "release:verify-packed-install": "cargo run --quiet --package seekdeep-repository-tools --bin release-verify-packed-install --",
    "release:publish": "cargo run --quiet --package seekdeep-repository-tools --bin release-publish --",
    "seekdeep": "cargo run --quiet --package seekdeep --",
    "demo:code-mode": "cargo run --quiet --package seekdeep-demo-launcher --bin seekdeep-demo-code-mode --",
    "demo:cordis": "cargo run --quiet --package seekdeep-demo-launcher --bin seekdeep-demo-cordis --",
    "demo:acp": "cargo run --quiet --package seekdeep-acp-demo -- --config examples/acp-agent/cordis.yml",
    "mock:llm": "cargo run --quiet -p seekdeep-llm-mock-server --",
    "dev:web": "cargo xtask dev-web --poll",
    "postinstall": "pnpm run install-lefthook"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@seekdeep-ai/seekdeep-tool-session-query": "workspace:^",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@yarnpkg/cli-dist": "4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "execa": "^10.0.0",
    "fast-check": "^4.8.0",
    "istanbul-lib-report": "^3.0.1",
    "js-yaml": "^4.2.0",
    "jscpd": "^5.0.12",
    "jsdom": "29.1.1",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "^0.3.21",
    "smol-toml": "^1.7.1",
    "spdx-expression-parse": "^5.0.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
