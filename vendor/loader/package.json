{
  "name": "@seekdeep-ai/cordis-plugin-loader",
  "description": "Plugin loader for cordis",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "vendor/loader"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.d.ts",
    "lib/client_bg.wasm",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@seekdeep-ai/cordis": "workspace:^",
    "node-addon-require-builtin": "^0.1.4"
  },
  "peerDependenciesMeta": {
    "node-addon-require-builtin": {
      "optional": true
    }
  },
  "dependencies": {
    "@seekdeep-ai/cosmokit": "workspace:^"
  },
  "scripts": {
    "bundle": "cargo xtask wasm-package --package seekdeep-client-loader --artifact seekdeep_client_loader --module-id @seekdeep-ai/cordis-plugin-loader --out-dir vendor/loader/lib"
  }
}
