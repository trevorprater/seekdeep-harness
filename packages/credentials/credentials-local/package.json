{
  "name": "@seekdeep-ai/seekdeep-credentials-local",
  "description": "File-backed credentials provider ($SEEKDEEP_HOME/.env under the live process environment) for the SeekDeep Harness",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-atomic-write": "workspace:^",
    "@seekdeep-ai/seekdeep-credentials": "workspace:^",
    "@seekdeep-ai/seekdeep-launch-environment": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-home-paths": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@seekdeep-ai/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@seekdeep-ai/seekdeep-atomic-write": "workspace:^",
    "@seekdeep-ai/seekdeep-credentials": "workspace:^",
    "@seekdeep-ai/seekdeep-launch-environment": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-home-paths": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "seekdeep": {
    "compiled": true
  }
}
