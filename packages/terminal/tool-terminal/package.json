{
  "name": "@seekdeep-ai/seekdeep-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/terminal/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@seekdeep-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-agent": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-terminal": "workspace:^",
    "@seekdeep-ai/seekdeep-output-retention": "workspace:^",
    "@seekdeep-ai/seekdeep-system-prompt": "workspace:^",
    "@seekdeep-ai/seekdeep-jobs": "workspace:^",
    "@seekdeep-ai/seekdeep-tools": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/cordis-plugin-include": "workspace:^",
    "@seekdeep-ai/cordis-plugin-loader": "workspace:^",
    "@seekdeep-ai/seekdeep-agent": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-terminal": "workspace:^",
    "@seekdeep-ai/seekdeep-terminal-bash": "workspace:^",
    "@seekdeep-ai/seekdeep-output-retention": "workspace:^",
    "@seekdeep-ai/seekdeep-sandbox": "workspace:^",
    "@seekdeep-ai/seekdeep-sandbox-policy": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-subprocess-local": "workspace:^",
    "@seekdeep-ai/seekdeep-system-prompt": "workspace:^",
    "@seekdeep-ai/seekdeep-jobs": "workspace:^",
    "@seekdeep-ai/seekdeep-jobs-local": "workspace:^",
    "@seekdeep-ai/seekdeep-tool-jobs": "workspace:^",
    "@seekdeep-ai/seekdeep-tools": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  }
}
