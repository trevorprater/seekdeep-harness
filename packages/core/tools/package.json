{
  "name": "@seekdeep-ai/seekdeep-tools",
  "version": "0.1.0-rc.5",
  "description": "Tool registry and execution pipeline for the SeekDeep Harness",
  "type": "module",
  "exports": {
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts"
    },
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@seekdeep-ai/seekdeep-llm": "workspace:^"
  },
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/core/tools"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts"
}
