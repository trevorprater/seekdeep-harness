{
  "name": "@seekdeep-ai/seekdeep-client-hmr",
  "description": "Dev-only hot-reload driver for script-loaded client entries: SSE rebuilt frames → invalidate/prefetch → fiber swap through the vendored Loader entry",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/client/hmr"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "seekdeep": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "compiled": true
  },
  "license": "MIT",
  "scripts": {
    "bundle": "cargo xtask wasm-package --package seekdeep-client-hmr --artifact seekdeep_client_hmr --module-id @seekdeep-ai/seekdeep-client-hmr --out-dir packages/client/hmr/lib",
    "watch": "cargo xtask wasm-package --package seekdeep-client-hmr --artifact seekdeep_client_hmr --module-id @seekdeep-ai/seekdeep-client-hmr --out-dir packages/client/hmr/lib --watch"
  },
  "dependencies": {
    "@seekdeep-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@seekdeep-ai/cordis-plugin-loader": "workspace:^",
    "@seekdeep-ai/seekdeep-client-modules": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/cordis-plugin-loader": "workspace:^",
    "@seekdeep-ai/seekdeep-client-modules": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "files": [
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
