{
  "name": "@seekdeep-ai/seekdeep-client-ui-directory-picker-native",
  "description": "Native directory-picker surface: the renderless workspace directory-flow occupant driving the host's OS chooser",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/client/ui-directory-picker-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "seekdeep": {
    "client": {
      "inject": [
        "@seekdeep-ai/seekdeep-client-runtime",
        "@seekdeep-ai/seekdeep-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "cargo xtask wasm-package --package seekdeep-client-ui-directory-picker-native --artifact seekdeep_client_ui_directory_picker_native --module-id @seekdeep-ai/seekdeep-client-ui-directory-picker-native --out-dir packages/client/ui-directory-picker-native/lib",
    "watch": "cargo xtask wasm-package --package seekdeep-client-ui-directory-picker-native --artifact seekdeep_client_ui_directory_picker_native --module-id @seekdeep-ai/seekdeep-client-ui-directory-picker-native --out-dir packages/client/ui-directory-picker-native/lib --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-client-runtime": "workspace:^",
    "@seekdeep-ai/seekdeep-client-ui-slots": "workspace:^",
    "@seekdeep-ai/seekdeep-client-ui-workspace": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@seekdeep-ai/seekdeep-client-runtime": "workspace:^",
    "@seekdeep-ai/seekdeep-client-ui-slots": "workspace:^",
    "@seekdeep-ai/seekdeep-client-ui-workspace": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@seekdeep-ai/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
