{
  "name": "@seekdeep-ai/seekdeep-cordis-host-runner",
  "description": "Dynamic package definition registry, host-half sandbox lifecycle, and invoke handler table for model-mounted dual-half packages",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/extensions/cordis-host-runner"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@seekdeep-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@seekdeep-ai/cordis": "workspace:^",
    "@seekdeep-ai/seekdeep-brand": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-tools": "workspace:^",
    "@seekdeep-ai/seekdeep-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/cordis": "workspace:^",
    "@seekdeep-ai/cordis-plugin-timer": "workspace:^",
    "@seekdeep-ai/seekdeep-brand": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-tools": "workspace:^",
    "@seekdeep-ai/seekdeep-typert-protocol": "workspace:^"
  },
  "seekdeep": {
    "compiled": true
  }
}
