{
  "name": "@seekdeep-ai/seekdeep-tool-cordis",
  "description": "Self-referential cordis toolset: inspect the live runtime, mount and dispose model-written plugins",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/extensions/tool-cordis"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-agent": "workspace:^",
    "@seekdeep-ai/seekdeep-cordis-host-runner": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-scope": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-system-prompt": "workspace:^",
    "@seekdeep-ai/seekdeep-tools": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/cordis-plugin-loader": "workspace:^",
    "@seekdeep-ai/seekdeep-agent": "workspace:^",
    "@seekdeep-ai/seekdeep-cordis-host-runner": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-scope": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-system-prompt": "workspace:^",
    "@seekdeep-ai/seekdeep-tools": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  }
}
