  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/session/session-projection-cache"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@seekdeep-ai/schemastery": "workspace:^",
