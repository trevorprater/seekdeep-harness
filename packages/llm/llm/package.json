{
  "name": "@seekdeep-ai/seekdeep-llm",
  "version": "0.1.0-rc.5",
  "description": "Provider-neutral LLM service interface for the SeekDeep Harness",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts"
    },
    "./message": {
      "types": "./lib/types/message.d.ts"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@seekdeep-ai/cordis": "workspace:^",
    "@seekdeep-ai/schemastery": "workspace:^",
    "@seekdeep-ai/seekdeep-attachment": "workspace:^",
    "@seekdeep-ai/seekdeep-brand": "workspace:^"
  },
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/llm/llm"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts"
}
