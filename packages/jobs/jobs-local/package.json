{
  "name": "@seekdeep-ai/seekdeep-jobs-local",
  "description": "Process-local implementation of the SeekDeep Harness background job registry seam",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-agent": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-scope": "workspace:^",
    "@seekdeep-ai/seekdeep-jobs": "workspace:^",
    "@seekdeep-ai/seekdeep-timeout": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@seekdeep-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/cordis-plugin-include": "workspace:^",
    "@seekdeep-ai/cordis-plugin-loader": "workspace:^",
    "@seekdeep-ai/seekdeep-agent": "workspace:^",
    "@seekdeep-ai/seekdeep-brand": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-scope": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-jobs": "workspace:^",
    "@seekdeep-ai/seekdeep-timeout": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  }
}
