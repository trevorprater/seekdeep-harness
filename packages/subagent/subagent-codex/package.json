{
  "name": "@seekdeep-ai/seekdeep-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-sdk-protocol": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-subagent": "workspace:^",
    "@seekdeep-ai/seekdeep-subprocess": "workspace:^",
    "@seekdeep-ai/seekdeep-timeout": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@seekdeep-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/cordis-plugin-loader": "workspace:^",
    "@seekdeep-ai/seekdeep-agent": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-loader-smoke": "workspace:^",
    "@seekdeep-ai/seekdeep-sdk-protocol": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-subagent": "workspace:^",
    "@seekdeep-ai/seekdeep-subprocess": "workspace:^",
    "@seekdeep-ai/seekdeep-subprocess-local": "workspace:^",
    "@seekdeep-ai/seekdeep-timeout": "workspace:^",
    "@openai/codex": "0.147.0",
    "@seekdeep-ai/cordis": "workspace:^"
  }
}
