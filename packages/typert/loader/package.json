{
  "name": "@seekdeep-ai/seekdeep-typert-loader",
  "description": "Loader integration for generated Typert package contributions",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/typert/loader"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@seekdeep-ai/cordis-plugin-loader": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-typert-registry": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@seekdeep-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/cordis-plugin-loader": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-typert-registry": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^",
    "zod": "^4.4.3"
  },
  "seekdeep": {
    "compiled": true
  }
}
