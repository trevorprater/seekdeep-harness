{
  "name": "@seekdeep-ai/seekdeep-spill-policy",
  "description": "Tool-result spill policy for the SeekDeep Harness — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/seekdeep-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-output-retention": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-spill": "workspace:^",
    "@seekdeep-ai/seekdeep-tools": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@seekdeep-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@seekdeep-ai/seekdeep-agent": "workspace:^",
    "@seekdeep-ai/seekdeep-code-runtime-worker-thread": "workspace:^",
    "@seekdeep-ai/seekdeep-invariants": "workspace:^",
    "@seekdeep-ai/seekdeep-llm": "workspace:^",
    "@seekdeep-ai/seekdeep-output-retention": "workspace:^",
    "@seekdeep-ai/seekdeep-session": "workspace:^",
    "@seekdeep-ai/seekdeep-spill": "workspace:^",
    "@seekdeep-ai/seekdeep-tools": "workspace:^",
    "@seekdeep-ai/cordis": "workspace:^"
  },
  "seekdeep": {
    "compiled": true
  }
}
